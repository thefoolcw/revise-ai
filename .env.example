# ── Revise AI environment reference ───────────────────────────────
# Placeholder names ONLY. Never commit real values.

# Core
NODE_ENV=development
APP_URL=http://localhost:3000

# Database — PGlite for local dev, PostgreSQL for production
#   dev:  file:./data/pgdata
#   prod: postgres://user:pass@host:5432/revise_ai
DATABASE_URL=file:./data/pgdata

# TLS for the postgres:// driver only (ignored for PGlite file:/memory: URLs).
#   auto     = require TLS in production, none otherwise (default; correct for Neon/Supabase)
#   require  = always verify the server certificate
#   disable  = never use TLS. Local/trusted databases only — never a hosted provider.
DATABASE_SSL=auto

# Auth / crypto (generate your own; 32+ chars each)
AUTH_SECRET=
ENCRYPTION_KEY=

# AI provider — NVIDIA hosted OpenAI-compatible endpoint
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Premium key provider — JNKIE (https://docs.jnkie.com/rest-api/keys)
JUNKIE_API_KEY=
JUNKIE_BASE_URL=https://api.jnkie.com
JUNKIE_KEYS_PATH=/api/v2/keys
# DEV-only mock; refuses to activate when NODE_ENV=production
JUNKIE_MOCK=false

# Premium acquisition (public invite link only — no bot token)
DISCORD_INVITE_URL=https://discord.gg/m4nUrSESum

# Premium product (integer minor units, decimal-safe)
PREMIUM_PRICE_MINOR=399
PREMIUM_CURRENCY=GBP
